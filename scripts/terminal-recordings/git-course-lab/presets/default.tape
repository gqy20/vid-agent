Set FontFamily "JetBrains Mono"
Set FontSize 25
Set Width 1240
Set Height 640
Set Padding 34
Set LineHeight 1.24
Set BorderRadius 0
Set CursorBlink false
Set Theme { "name": "GitCourseLab Ink Teal", "black": "#101816", "red": "#e46f5d", "green": "#65d1c8", "yellow": "#f0d264", "blue": "#6d8f8f", "magenta": "#b899ff", "cyan": "#65d1c8", "white": "#edf3ef", "brightBlack": "#53615c", "brightRed": "#ff8a78", "brightGreen": "#87ded8", "brightYellow": "#ffe38a", "brightBlue": "#91a8ff", "brightMagenta": "#d3c2ff", "brightCyan": "#9ae8e2", "brightWhite": "#ffffff", "background": "#17211f", "foreground": "#edf3ef", "selection": "#263733", "cursor": "#f0d264" }
Set TypingSpeed 35ms

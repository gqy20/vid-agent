{
  "name": "git-course-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit && node --check server.mjs && node --check src/lib.mjs && node --check scripts/dev.mjs && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "packageManager": "pnpm@10.33.2"
}

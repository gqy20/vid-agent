{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/github-course-episode.schema.json",
  "title": "GitHub Course Episode",
  "$comment": "Shared lifecycle rules live in docs/course-production.md. Release remains optional until the 4K release adapter is implemented.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "episodeId",
    "title",
    "status",
    "fps",
    "resolution",
    "deliveryResolution",
    "durationSeconds",
    "audio",
    "sourceOfTruth",
    "scenes"
  ],
  "properties": {
    "episodeId": {
      "type": "string",
      "pattern": "^gh[0-9]{2}-[a-z0-9-]+$"
    },
    "title": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["outline", "draft", "production", "review", "released"]
    },
    "fps": {"const": 30},
    "resolution": {
      "description": "Fast iteration and review resolution. This artifact is never directly promotable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"const": 1920},
        "height": {"const": 1080}
      }
    },
    "deliveryResolution": {
      "description": "Required final master and release resolution.",
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"const": 3840},
        "height": {"const": 2160}
      }
    },
    "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "voice", "language", "speed", "bgm"],
      "properties": {
        "model": {"const": "speech-2.8-hd"},
        "voice": {"const": "Chinese (Mandarin)_Gentleman"},
        "language": {"const": "zh"},
        "speed": {"const": 1.25},
        "bgm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "volume"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "volume": {"const": 0.05}
          }
        }
      }
    },
    "sourceOfTruth": {
      "type": "object",
      "required": ["references"],
      "properties": {
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "verifiedAt": {"type": "string", "format": "date"}
      }
    },
    "browserRecordings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenarioId", "src", "poster", "metadata", "viewport", "containsSensitiveState"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "scenarioId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "src": {"type": "string", "pattern": "^github-course/browser/.+\\.mp4$"},
          "poster": {"type": "string", "pattern": "^github-course/browser/.+-poster\\.png$"},
          "metadata": {"type": "string", "pattern": "^github-course/browser/.+\\.json$"},
          "viewport": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": {"type": "integer", "minimum": 1280},
              "height": {"type": "integer", "minimum": 720}
            }
          },
          "delivery": {
            "description": "Native UHD browser evidence used only by the 4K delivery profile.",
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "poster", "metadata", "viewport", "captureResolution", "deviceScaleFactor", "captureMode"],
            "properties": {
              "src": {"type": "string", "pattern": "^github-course/browser/uhd30/.+\\.mp4$"},
              "poster": {"type": "string", "pattern": "^github-course/browser/uhd30/.+-poster\\.png$"},
              "metadata": {"type": "string", "pattern": "^github-course/browser/uhd30/.+\\.json$"},
              "viewport": {
                "type": "object",
                "additionalProperties": false,
                "required": ["width", "height"],
                "properties": {
                  "width": {"const": 1600},
                  "height": {"const": 900}
                }
              },
              "captureResolution": {
                "type": "object",
                "additionalProperties": false,
                "required": ["width", "height"],
                "properties": {
                  "width": {"const": 3840},
                  "height": {"const": 2160}
                }
              },
              "deviceScaleFactor": {"const": 2.4},
              "captureMode": {"const": "native-window-dsf"}
            }
          },
          "containsSensitiveState": {"const": false}
        }
      }
    },
    "release": {
      "description": "Episode-owned release copy, cover brief, checks and published artifact metadata. Required when the release adapter is enabled.",
      "type": "object",
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "caption", "start", "duration", "goal", "primaryTechnique"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "goal": {"type": "string", "minLength": 1},
          "primaryTechnique": {
            "enum": [
              "Remotion",
              "BrowserFocusScene",
              "BrowserEvidenceScene",
              "GitHubStateBridge",
              "GitGraph",
              "ManimBridge"
            ]
          },
          "browserRecordingId": {"type": "string"},
          "components": {
            "type": "array",
            "items": {"type": "string"}
          },
          "narration": {
            "type": "object",
            "required": ["segmentId", "voiceStart", "text"],
            "properties": {
              "segmentId": {"type": "string"},
              "voiceStart": {"type": "number", "minimum": 0},
              "text": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}

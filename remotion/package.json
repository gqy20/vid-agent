{
  "name": "remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts CCInsightsPromo out/video.mp4 --concurrency=4 --timeout=120000",
    "render:fast": "remotion render src/index.ts CCInsightsPromo out/video-fast.mp4 --concurrency=8 --timeout=120000 --muted",
    "render:ranges": "JOBS=1 CONCURRENCY=8 TIMEOUT=120000 MUTED=1 scripts/render-ranges.sh CCInsightsPromo cc-insights-promo auto 600",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.484",
    "@remotion/cli": "^4.0.0",
    "@remotion/transitions": "^4.0.484",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.4.0"
  }
}

{
  "name": "remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "scripts/render-final.sh CCInsightsPromo cc-insights-promo",
    "render:analyze": "scripts/analyze-render.sh",
    "render:direct": "remotion render src/index.ts CCInsightsPromo out/video.mp4 --concurrency=4 --timeout=120000",
    "render:fast": "remotion render src/index.ts CCInsightsPromo out/video-fast.mp4 --concurrency=8 --timeout=120000 --muted",
    "render:ranges": "TIMEOUT=120000 MUTED=1 scripts/render-ranges.sh CCInsightsPromo cc-insights-promo auto 600",
    "git-course:validate": "node scripts/git-course.mjs validate",
    "git-course:generate": "node scripts/git-course.mjs generate",
    "git-course:narration": "node scripts/git-course.mjs narration",
    "git-course:release": "node scripts/git-course.mjs release",
    "git-course": "node scripts/git-course-cli.mjs",
    "github-course": "node scripts/github-course-cli.mjs",
    "segments:audit": "scripts/audit-range-segments.sh",
    "audit:overlaps": "scripts/audit-overlaps.sh",
    "meta:sync": "scripts/sync-current-meta.sh",
    "video:audit": "scripts/audit-video-stills.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.484",
    "@remotion/bundler": "^4.0.484",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.484",
    "@remotion/transitions": "^4.0.484",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.4.0"
  }
}

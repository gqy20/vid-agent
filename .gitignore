# vid-agent 项目 gitignore
# ==============================
# 该 commit（不 ignore）:
#   - .claude/skills/<skill>/baseline/  (skill 开发过程，与 skill 同寿)
#   - renders/                          (项目作品)
#   - uv.lock, pyproject.toml, README.md, CLAUDE.md, docs/
# ==============================

# ── Python (uv-managed) ──
# uv 虚拟环境
.venv/
# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# ── 视频产物（白名单：只追踪 current/*.mp4 + 元数据）──
# 原则：默认 ignore 所有视频产物目录，只白名单 renders/*/renders/current/*.mp4。
# 新增任何命名/目录自动被忽略，永不漏。
# 详见 .claude/skills/{remotion-vid,manim-viz}/references/render-project-layout.md
# 注：用单层通配 renders/*/X/，不用 **/X/（多层 + 多规则共存时 git 对短目录名有 quirk）。

# manim 默认输出 + 中间产物
media/
**/_build/
**/partial_movie_files/

# 非 current 的产物目录一律 ignore（manim: renders/<id>/renders/...）
renders/*/renders/debug/
renders/*/renders/tmp/
renders/*/renders/candidates/
renders/*/renders/archive/
renders/*/renders/segments/
renders/*/renders/hook/
renders/*/renders/final/        # 旧布局过渡期保留

# remotion: remotion/renders/<id>/renders/...
remotion/renders/*/renders/debug/
remotion/renders/*/renders/tmp/
remotion/renders/*/renders/candidates/
remotion/renders/*/renders/archive/
remotion/renders/*/renders/segments/
remotion/renders/*/renders/hook/
remotion/renders/*/renders/final/
remotion/renders/*/renders/mix.mp3

# remotion series layout: remotion/renders/<series>/<episode>/renders/...
remotion/renders/*/*/renders/debug/
remotion/renders/*/*/renders/tmp/
remotion/renders/*/*/renders/candidates/
remotion/renders/*/*/renders/archive/
remotion/renders/*/*/renders/segments/
remotion/renders/*/*/renders/hook/
remotion/renders/*/*/renders/final/
remotion/renders/*/*/renders/mix.mp3

# 兜底：renders 下散落的 mp4 全 ignore，白名单 current/
renders/*/renders/*.mp4
renders/*/renders/*/*.mp4
remotion/renders/*/renders/*.mp4
remotion/renders/*/renders/*/*.mp4
remotion/renders/*/*/renders/*.mp4
remotion/renders/*/*/renders/*/*.mp4
!renders/*/renders/current/*.mp4
!remotion/renders/*/renders/current/*.mp4
!remotion/renders/*/*/renders/current/*.mp4

# 抽帧调试临时 + 媒体资产（可由脚本重新生成）
renders/*/frames/
renders/*/frames_v2/
renders/*/current/stills/
remotion/renders/*/current/stills/
remotion/renders/*/*/current/stills/
renders/*/tts/*.wav
renders/*/bgm/*.wav

# 旧命名存量（promote.sh 强制新规范后不再产生，过渡期兜底）
*-V2.mp4
*-V2.png
*-fix.mp4
*-fix.png
*-concat*.mp4
thumbnail-V2.png
thumbnail-final.png
thumbnail-fix.png
thumbnail-*.png

# ── Remotion 工程临时（非视频产物）──
remotion/node_modules/
remotion/node_modules.pnp
remotion/out/
remotion/.next/
remotion/dist/
mmx-renders/
.playwright-cli/
remotion/.playwright-cli/
fronts/candidates/
fronts/*.otf
fronts/*.ttf
fronts/*.ttc
remotion/public/fonts/
remotion/src/font-assets/

# ── 外部参考资料本地缓存 ──
# 可通过 scripts/fetch-progit-references.sh 重新拉取；主仓库只提交索引和脚本。
docs/references/progit2/
docs/references/progit2-zh/

# ── 密钥 / 本地配置 ──
.env
.env.local
*.pem
*.key
*.secret

# ── 编辑器 / IDE 个人设置 ──
# PyCharm/IntelliJ
.idea/
# VSCode（个人偏好，不入库）
.vscode/
.codex/
*.swp
*.swo
*~
*.bak
*.tmp
*.orig

# ── OS 垃圾 ──
.DS_Store
Thumbs.db

# vid-agent 项目 gitignore
# ==============================
# 该 commit（不 ignore）:
#   - .claude/skills/<skill>/baseline/  (skill 开发过程，与 skill 同寿)
#   - renders/ 中的源码、配置和生产文档（生成媒体不提交）
#   - uv.lock, pyproject.toml, README.md, CLAUDE.md, docs/
# ==============================

# ── Python (uv-managed) ──
# uv 虚拟环境
.venv/
# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# ── 视频产物 ──
# 原则：默认 ignore 可重新生成的视频、音频、字幕、抽帧和审查产物。
# 仓库只提交源码、脚本、文稿、对齐说明和生产文档；生成媒体保留在本地。
# 新增任何生成媒体命名/目录自动被忽略，永不漏。
# 详见 .claude/skills/{remotion-vid,manim-viz}/references/render-project-layout.md
# 注：用单层通配 renders/*/X/，不用 **/X/（多层 + 多规则共存时 git 对短目录名有 quirk）。

# manim 默认输出 + 中间产物
media/
**/_build/
**/partial_movie_files/

# renders 目录中的媒体均为可重新生成的本地产物；源码、配置和文档继续入库。
renders/**/*.mp4
renders/**/*.mov
renders/**/*.webm
renders/**/*.mp3
renders/**/*.m4a
renders/**/*.wav
renders/**/*.srt
renders/**/*.png
renders/**/*.jpg
renders/**/*.jpeg
renders/**/*.gif
remotion/renders/**/*.mp4
remotion/renders/**/*.mov
remotion/renders/**/*.webm
remotion/renders/**/*.mp3
remotion/renders/**/*.m4a
remotion/renders/**/*.wav
remotion/renders/**/*.srt
remotion/renders/**/*.png
remotion/renders/**/*.jpg
remotion/renders/**/*.jpeg
remotion/renders/**/*.gif

# 非 current 的产物目录一律 ignore（manim: renders/<id>/renders/...）
renders/*/renders/debug/
renders/*/renders/tmp/
renders/*/renders/candidates/
renders/*/renders/archive/
renders/*/renders/segments/
renders/*/renders/hook/
renders/*/renders/final/        # 旧布局过渡期保留

# remotion: remotion/renders/<id>/renders/...
remotion/renders/*/renders/debug/
remotion/renders/*/renders/tmp/
remotion/renders/*/renders/candidates/
remotion/renders/*/renders/archive/
remotion/renders/*/renders/segments/
remotion/renders/*/renders/hook/
remotion/renders/*/renders/final/
remotion/renders/*/renders/mix.mp3

# 扁平 series 布局：remotion/renders/<series>/<episode>/{current,tmp}
# 可由脚本重新生成的音视频产物默认不入库。
# 保留 .txt/.md 等文稿和对齐说明。
remotion/renders/*/*/tmp/
remotion/renders/github-course/tmp/
# 审查正文已整合进 episode JSON；renders 下的副本属于本地报告。
remotion/renders/*/*/quality-audit.md
remotion/renders/*/*/current/release/
remotion/renders/*/*/current/release/*.png
remotion/renders/*/*/current/release/*.jpg
remotion/renders/*/*/current/release/*.jpeg
remotion/renders/*/*/current/release/*.svg
remotion/renders/*/*/current/scenes/
remotion/renders/*/*/current/*.mp4
remotion/renders/*/*/current/*/*.mp4
remotion/renders/*/*/current/audio/*.mp3
remotion/renders/*/*/current/audio/*.m4a
remotion/renders/*/*/current/audio/*.wav
remotion/renders/*/*/current/audio/*.srt
remotion/renders/*/*/current/audio/**/*.txt
remotion/renders/*/*/current/audio/**/*.tsv
remotion/renders/*/*/current/audit/
remotion/public/git-course/manim/**/*.mp4
remotion/public/git-course-lab/manim/
remotion/public/git-course-lab/terminal/*.mp4
remotion/public/git-course-lab/terminal/*-hold.png
remotion/public/git-course-lab/terminal/*.json

# claude-code-course 录屏产物（同 git-course-lab 约定）
remotion/public/claude-code-course/audio/
remotion/public/claude-code-course/terminal/*.mp4
remotion/public/claude-code-course/terminal/*-hold.png
remotion/public/claude-code-course/terminal/*.json
# 录屏 PNG 帧序列（OffthreadVideo 环境崩溃 workaround，ffmpeg 预抽帧，可重新生成）
remotion/public/claude-code-course/terminal/*-frames/
# GitHub Course 浏览器录制产物与本地认证状态（均可重建，认证状态严禁提交）
remotion/public/github-course/browser/**/*.mp4
remotion/public/github-course/browser/**/*.webm
remotion/public/github-course/browser/**/*-poster.png
remotion/public/github-course/browser/**/*.json
scripts/browser-recordings/github-course-lab/.auth/
scripts/browser-recordings/github-course-lab/tmp/
# 敏感值中间产物（真实 token 录制源，防御性 ignore）
*-sensitive.mp4
*-masked.mp4

# yazi 二进制本地缓存（record-tmux.sh 按需下载解压，不入库）
scripts/terminal-recordings/claude-code-lab/envs/base/yazi.bin

# 旧目录形态的兼容规则。
renders/tmp/
renders/*/renders/*.mp4
renders/*/renders/*/*.mp4
remotion/renders/*/renders/*.mp4
remotion/renders/*/renders/*/*.mp4
remotion/renders/*/*/*.mp4
remotion/renders/*/*/*.png
remotion/renders/*/*/*.jpg
remotion/renders/*/*/*.jpeg

# 抽帧调试临时 + 媒体资产（可由脚本重新生成）
renders/*/frames/
renders/*/frames_v2/
renders/*/current/stills/
remotion/renders/*/current/stills/
remotion/renders/*/*/current/stills/
remotion/renders/*/*/stills/
renders/*/tts/*.wav
renders/*/bgm/*.wav

# 旧命名存量（promote.sh 强制新规范后不再产生，过渡期兜底）
*-V2.mp4
*-V2.png
*-fix.mp4
*-fix.png
*-concat*.mp4
thumbnail-V2.png
thumbnail-final.png
thumbnail-fix.png
thumbnail-*.png

# ── Remotion 工程临时（非视频产物）──
remotion/node_modules/
remotion/node_modules.pnp
remotion/out/
remotion/.next/
remotion/dist/
mmx-renders/
.playwright-cli/
remotion/.playwright-cli/
fronts/candidates/
fronts/*.otf
fronts/*.ttf
fronts/*.ttc
remotion/public/fonts/*
!remotion/public/fonts/GitCourseSourceCodePro-Medium.otf
remotion/src/font-assets/

# ── 外部参考资料本地缓存 ──
# 可通过 scripts/fetch-progit-references.sh 重新拉取；主仓库只提交索引和脚本。
docs/references/progit2/
docs/references/progit2-zh/
docs/references/claude-code/
ref/*

# ── 密钥 / 本地配置 ──
.env
.env.local
*.pem
*.key
*.secret

# ── 编辑器 / IDE 个人设置 ──
# PyCharm/IntelliJ
.idea/
# VSCode（个人偏好，不入库）
.vscode/
.codex/
*.swp
*.swo
*~
*.bak
*.tmp
*.orig

# ── OS 垃圾 ──
.DS_Store
Thumbs.db

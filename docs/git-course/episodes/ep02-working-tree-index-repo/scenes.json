    "modified": {
      "workingTree": ["app.js:modified"],
      "index": [],
      "repository": ["C0"]
    },
    "staged": {
      "workingTree": ["app.js:v1"],
      "index": ["app.js:v1"],
      "repository": ["C0"]
    },
    "stagedAndModified": {
      "workingTree": ["app.js:v2"],
      "index": ["app.js:v1"],
      "repository": ["C0"]
    },
    "committed": {
      "workingTree": ["app.js:v2:uncommitted"],
      "index": [],
      "repository": ["C0", "C1:v1"]
    }
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/claude-code-course-episode.schema.json",
  "title": "Claude Code Course Episode",
  "$comment": "Target schema for migrated and new episodes. The legacy ep01-agentic-loop.json intentionally does not conform until migration.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "episodeId",
    "compositionId",
    "title",
    "status",
    "fps",
    "resolution",
    "durationSeconds",
    "continuity",
    "audio",
    "sourceOfTruth",
    "verifiedWith",
    "scenes",
    "release"
  ],
  "properties": {
    "episodeId": {
      "type": "string",
      "pattern": "^ep[0-9]{2}-[a-z0-9-]+$"
    },
    "compositionId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]+$"
    },
    "title": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["outline", "draft", "production", "review", "released"]
    },
    "fps": {"const": 30},
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"const": 1920},
        "height": {"const": 1080}
      }
    },
    "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapterIndex",
        "chapterLabel",
        "previousEpisodeId",
        "nextEpisodeId",
        "entryState",
        "exitState",
        "incomingQuestion",
        "outgoingQuestion",
        "visualBaton",
        "scenes"
      ],
      "properties": {
        "chapterIndex": {"type": "integer", "minimum": 1},
        "chapterLabel": {"type": "string", "minLength": 1},
        "previousEpisodeId": {"type": ["string", "null"]},
        "nextEpisodeId": {"type": ["string", "null"]},
        "entryState": {"type": "string", "minLength": 1},
        "exitState": {"type": "string", "minLength": 1},
        "incomingQuestion": {"type": "string", "minLength": 1},
        "outgoingQuestion": {"type": "string", "minLength": 1},
        "visualBaton": {"type": "string", "minLength": 1},
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sceneId", "entryState", "change", "exitState", "handoff"],
            "properties": {
              "sceneId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "entryState": {"type": "string", "minLength": 1},
              "change": {"type": "string", "minLength": 1},
              "exitState": {"type": "string", "minLength": 1},
              "handoff": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "target", "visualAnchor"],
                "properties": {
                  "type": {
                    "enum": [
                      "question-handoff",
                      "evidence-continuation",
                      "causal-handoff",
                      "zoom-in",
                      "synthesis",
                      "chapter-bridge",
                      "closure"
                    ]
                  },
                  "target": {"type": ["string", "null"]},
                  "visualAnchor": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": true,
      "required": ["model", "voice", "language", "speed"],
      "properties": {
        "model": {"const": "speech-2.8-hd"},
        "voice": {"const": "Chinese (Mandarin)_Gentleman"},
        "language": {"const": "zh"},
        "speed": {"const": 1.25},
        "bgm": {
          "type": "object",
          "required": ["source", "volume"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "volume": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "sourceOfTruth": {
      "type": "object",
      "required": ["references"],
      "properties": {
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "verifiedWith": {
      "type": "object",
      "additionalProperties": true,
      "required": ["date", "claudeCodeVersion"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "claudeCodeVersion": {"type": "string", "minLength": 1}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "start", "duration", "goal", "narration"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "goal": {"type": "string", "minLength": 1},
          "narration": {
            "type": "object",
            "additionalProperties": true,
            "required": ["segmentId", "voiceStart", "text"],
            "properties": {
              "segmentId": {
                "type": "string",
                "pattern": "^[0-9]{2}_[a-z0-9_]+$"
              },
              "voiceStart": {"type": "number", "minimum": 0},
              "text": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

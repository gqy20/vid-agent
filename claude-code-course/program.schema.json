{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/claude-code-course-program.schema.json",
  "title": "Claude Code Course Program",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "courseId", "title", "renderPolicy", "volumes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "courseId": {"const": "claude-code-course"},
    "title": {"type": "string", "minLength": 1},
    "renderPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "masterAssembly", "chapterBoundary", "packaging", "volumeAudio"],
      "properties": {
        "unit": {"const": "chapter"},
        "masterAssembly": {"const": "sha-bound-chapter-segments"},
        "chapterBoundary": {"const": "hard-cut-with-visual-baton"},
        "packaging": {"const": "volume-only"},
        "volumeAudio": {"const": "chapter-voice-continuous-bgm"}
      }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "volumeId",
          "title",
          "promise",
          "compositionId",
          "chapters",
          "entryState",
          "exitState"
        ],
        "properties": {
          "volumeId": {"type": "string", "pattern": "^vol[0-9]{2}-[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "promise": {"type": "string", "minLength": 1},
          "compositionId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$"},
          "chapters": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^ep[0-9]{2}-[a-z0-9-]+$"}
          },
          "entryState": {"type": "string", "minLength": 1},
          "exitState": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
